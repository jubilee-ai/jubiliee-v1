          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "tenure_group",
        "formula": {
          "op": "bin",
          "column": "tenure",
          "bins": [
            0.0,
            12.0,
            24.0,
            36.0,
            48.0,
            60.0,
            72.0,
            100.0
          ],
          "strategy": "uniform",
          "labels": [
            "0_12",
            "13_24",
            "25_36",
            "37_48",
            "49_60",
            "61_72",
            "73_plus"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "AvgMonthlyCharge",
        "formula": {
          "op": "expression",
          "expression": "TotalCharges / (tenure + 1)",
          "source_columns": [
            "TotalCharges",
            "tenure"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "ChargeRatio",
        "formula": {
          "op": "expression",
          "expression": "MonthlyCharges / (TotalCharges + 1)",
          "source_columns": [
            "MonthlyCharges",
            "TotalCharges"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "tenure_x_MonthlyCharges",
        "formula": {
          "op": "expression",
          "expression": "tenure * MonthlyCharges",
          "source_columns": [
