        "name": "NumServices",
        "formula": {
          "op": "expression",
          "expression": "(OnlineSecurity == 'Yes') + (OnlineBackup == 'Yes') + (DeviceProtection == 'Yes') + (TechSupport == 'Yes') + (StreamingTV == 'Yes') + (StreamingMovies == 'Yes')",
          "source_columns": [
            "OnlineSecurity",
            "OnlineBackup",
            "DeviceProtection",
            "TechSupport",
            "StreamingTV",
            "StreamingMovies"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "HasNoInternetService",
        "formula": {
          "op": "expression",
          "expression": "InternetService == 'No'",
          "source_columns": [
            "InternetService"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "IsMonthToMonth",
        "formula": {
          "op": "expression",
          "expression": "Contract == 'Month-to-month'",
          "source_columns": [
            "Contract"
          ]
        },
        "grain": "customer",
        "as_of_constraint": null
      },
      {
        "name": "IsElectronicCheck",
        "formula": {
          "op": "expression",
